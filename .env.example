# Every setting PacePay uses. The real values live in `.env`, encrypted with dotenvx.
# To read them you need `.env.keys` (ask Ram; never commit it). See README → Setup.

# --- TrueFoundry gateway: one key for almost every model (Ram's account) ---
TRUEFOUNDRY_API_KEY=                                               # Ram's machine only: in the gitignored .env.local, not .env
TRUEFOUNDRY_BASE_URL=                                              # the gateway's /v1 URL (value is in the encrypted .env)
NEMOTRON_SUPER_MODEL=aws-bedrock/nvidia.nemotron-super-3-120b      # orchestrator and call decisions
NEMOTRON_NANO_MODEL=aws-bedrock/nvidia.nemotron-nano-3-30b         # faster call decisions once it handles tools reliably
NEMOTRON_VISION_MODEL=aws-bedrock/nvidia.nemotron-nano-12b-v2      # bill photos (Nemotron Nano 2 VL)
ANTHROPIC_MODEL=claude-group/claude-opus-5-5                       # second opinion, bill cross-check, arena grading
EMBED_MODEL=openai-group/text-embedding-3-small                    # terms lookup
IMAGE_MODEL=openai-group/gpt-image-2                               # test bill photos, brand art
TTS_MODEL=elevenlabs-primary/eleven_v3                             # Devpost voiceover

# --- NVIDIA build.nvidia.com: Nemotron 3 Ultra for the planner, and every Nemotron role in NVIDIA mode (SPEC §5.4) ---
NVIDIA_API_KEY=                                                    # shared, encrypted in .env
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b             # planner, simulated lenders
NEMOTRON_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b           # NVIDIA mode: orchestrator, decide, read_bill
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b                     # NVIDIA mode: get_terms
BREV_NEMOTRON_URL=                                                 # optional: OpenAI-compatible URL of our Brev GPU running Nemotron (SPEC §13)

# --- OpenAI: only for the call voice (GPT realtime isn't on the gateway) ---
OPENAI_API_KEY=                                                    # Ram's machine only: in the gitignored .env.local, not .env
OPENAI_REALTIME_MODEL=gpt-realtime-2.1                             # verified on a real call Nov 7; fall back to gpt-realtime-2, then gpt-realtime

# --- Photon 2.0 beta (app.beta.photon.codes → PacePay) ---
PHOTON_API_KEY=                 # project API key, pho_sk_... (full access, expires after 90 days)
PHOTON_PROJECT_ID=              # pho_prj_...
PHOTON_IMESSAGE_NUMBER=         # PacePay's shared iMessage number, E.164 (+1...)
PHOTON_VOICE_NUMBER=            # PacePay's SMS number with a voice profile, E.164
PHOTON_VOICE_PROFILE_ID=        # pho_vpf_... (the default voice profile)
PHOTON_CUSTOMER_SPACE_ID=       # pho_spc_... the customer's conversation with PacePay (from their first message)
PHOTON_AGENT_SENDER_ID=         # pho_usr_... PacePay's own sender ID on the shared line

# --- LiveKit Cloud (voice transport; SIP to Photon) ---
LIVEKIT_URL=                    # (plain) wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=  # ST_... outbound trunk to Photon (place_call uses it)
LIVEKIT_SIP_INBOUND_TRUNK_ID=   # ST_... inbound trunk for PacePay's call number
LIVEKIT_SIP_DISPATCH_RULE_ID=   # SDR_... sends each call to a photon-* room with the pacepay-voice agent

# --- Database ---
DATABASE_URL=                   # optional: unused for now, state is in memory (SPEC.md §1)

# --- Demo ---
CUSTOMER_PHONE=                 # the phone playing the demo customer (Yoshua), E.164
LENDER_PHONE=                   # the team phone the judge answers as the lender, E.164
INBOUND_PIN=                    # 4 digits the customer enters when calling PacePay
HOST=127.0.0.1                  # server bind address; loopback by default so approvals can't be answered from the network. 0.0.0.0 exposes it
SERVER_URL=http://localhost:8787                                   # (plain)
DASHBOARD_URL=http://localhost:3000                                # (plain)
