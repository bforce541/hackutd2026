# Every setting Margin uses. The real values live in `.env`, encrypted with dotenvx.
# To read them you need `.env.keys` (ask Ram; never commit it). See README → Setup.
# Secrets are encrypted in `.env`. Lines marked (plain) are safe to store unencrypted.

# --- NVIDIA Nemotron (build.nvidia.com → any model → "Get API Key") ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1                # (plain)
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b             # (plain) planner, simulated lenders
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b             # (plain) orchestrator
NEMOTRON_NANO_MODEL=nvidia/nemotron-nano-3-30b-a3b                 # (plain) call decisions; also try nvidia/nemotron-3.5-lightning-30b-a3b for speed
NEMOTRON_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b       # (plain) bill photos
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b                    # (plain) terms lookup
NVIDIA_RERANK_MODEL=                                               # (plain) optional; no reranker on the public model list

# --- OpenAI (call voice) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2                               # (plain) fall back to gpt-realtime if LiveKit's plugin rejects it

# --- Anthropic (second opinion, bill cross-check, arena grading) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5                                    # (plain)

# --- Photon 2.0 (app.photon.codes) ---
SPECTRUM_PROJECT_ID=            # Margin project ID (the spectrum-ts SDK reads this name)
SPECTRUM_PROJECT_SECRET=        # project secret; rotate it on Photon's Configure page if it leaks
PHOTON_IMESSAGE_NUMBER=         # Margin's iMessage line, E.164 (+1...)
PHOTON_VOICE_NUMBER=            # Margin's SMS number with a voice profile, E.164

# --- LiveKit Cloud (voice transport; SIP to Photon) ---
LIVEKIT_URL=                    # (plain) wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=  # (plain) starts with ST_

# --- Database ---
DATABASE_URL=                   # optional: unused for now, state is in memory (SPEC.md §1)

# --- Demo ---
JORDAN_PHONE=                   # the team phone playing Jordan, E.164
LENDER_PHONE=                   # the team phone the judge answers as the lender, E.164
INBOUND_PIN=                    # 4 digits Jordan enters when calling Margin
SERVER_URL=http://localhost:8787                                   # (plain)
DASHBOARD_URL=http://localhost:3000                                # (plain)
