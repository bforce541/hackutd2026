# Local environment files
# `.env` IS committed, but only encrypted with dotenvx (see README → Setup).
# `.env.keys` holds the private decryption key and must never be committed.
.env.*
!.env.example
*.local

# Credentials and secrets
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
secrets.*

# Runtime state written by the server (see SPEC.md)
data/

# macOS
.DS_Store

# Build output and dependencies
node_modules
.next
dist
*.tsbuildinfo
.vercel
.turbo
next-env.d.ts

# stress/test run outputs
scripts/stress/out/
scripts/voice-test/out/
