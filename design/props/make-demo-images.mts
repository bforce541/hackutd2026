/**
 * Builds the two demo-mode images in apps/dashboard/public/demo/:
 *   brake-quote.png  the printed repair quote (design/props/repair-quote.html), cropped for the web
 *   week-chart.png   PacePay's "week" chart image (UI.md "Chart image"), drawn from engine data
 *
 * The chart is the demo stand-in for what the server's chart.ts renders live. Never generated by a
 * model: every point comes from the engine.
 *
 * Run from the repo root (Node 22):
 *   npx tsx design/props/make-demo-images.mts
 * It needs Google Chrome for the quote screenshot (macOS path below).
 */
import { execFileSync } from 'node:child_process';
import { mkdtempSync, mkdirSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { billChange, fixtures, forecast, formatMoney, shortDate } from '../../packages/engine/src/index';

const root = new URL('../../', import.meta.url).pathname;
const out = join(root, 'apps/dashboard/public/demo');
mkdirSync(out, { recursive: true });
const requireFrom = (pkg: string) => createRequire(join(root, pkg, 'package.json'));
const { Resvg } = requireFrom('apps/server')('@resvg/resvg-js');
const sharp = requireFrom('apps/dashboard')('sharp');

// ---- the quote photo ------------------------------------------------------------------------
const CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
const shot = join(mkdtempSync(join(tmpdir(), 'pacepay-')), 'quote.png');
execFileSync(CHROME, [
  '--headless=new', '--disable-gpu', '--hide-scrollbars', '--force-device-scale-factor=1.5',
  '--window-size=816,1056', `--screenshot=${shot}`, `file://${join(root, 'design/props/repair-quote.html')}`,
], { stdio: 'ignore' });
await sharp(shot).extract({ left: 0, top: 0, width: 1224, height: 1330 }).resize({ width: 820 }).png({ compressionLevel: 9 }).toFile(join(out, 'brake-quote.png'));

// ---- the week chart -------------------------------------------------------------------------
const h = fixtures.household;
const fc = forecast(h, { days: 14, changes: [billChange(h, { amount: 65_000, day: 0, label: 'Northside Auto Service' })] });
const W = 1200, H = 800;
const plot = { x0: 90, x1: 1110, y0: 250, y1: 700 };
const n = fc.days.length;
const closes = fc.days.map((d) => d.close);
const top = 300_000, bot = -100_000;
const yOf = (v: number) => plot.y0 + ((top - v) / (top - bot)) * (plot.y1 - plot.y0);
const xOf = (i: number) => plot.x0 + (i / n) * (plot.x1 - plot.x0);
const step = closes.map((v, i) => `${xOf(i).toFixed(1)},${yOf(v).toFixed(1)} ${xOf(i + 1).toFixed(1)},${yOf(v).toFixed(1)}`).join(' ');
const zeroY = yOf(0);
const low = fc.lowest;
const lx = xOf(low.day + 0.5), ly = yOf(low.amount);
const negCols = closes.map((v, i) => (v < 0 ? i : -1)).filter((i) => i >= 0);
const hatch = negCols.map((i) => `<rect x="${xOf(i)}" y="${zeroY}" width="${xOf(i + 1) - xOf(i)}" height="${yOf(closes[i]!) - zeroY}" fill="url(#hatch)"/>`).join('');
const grid = [300_000, 200_000, 100_000, -100_000].map((v) => `<line x1="${plot.x0}" x2="${plot.x1}" y1="${yOf(v)}" y2="${yOf(v)}" stroke="#E4E2DB" stroke-width="2"/><text x="${plot.x0 - 14}" y="${yOf(v) + 8}" text-anchor="end" font-size="24" fill="#64615A">${formatMoney(v).replace('$300', '$3k').replace('$200', '$2k').replace('$100', '$1k').replace(/,000/, 'k')}</text>`).join('');
const tick = (day: number, text: string) => `<text x="${xOf(day + 0.5)}" y="${plot.y1 + 44}" text-anchor="middle" font-size="26" fill="#3D3B37">${text}</text>`;
const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" font-family="IBM Plex Sans, Helvetica Neue, Arial, sans-serif">
<defs><pattern id="hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="14" height="14" fill="#FBE8DF"/><line x1="0" y1="0" x2="0" y2="14" stroke="#C2410C" stroke-width="3"/></pattern></defs>
<rect width="${W}" height="${H}" fill="#F2F1ED"/>
<text x="90" y="104" font-size="54" font-weight="600" fill="#1C1B19">Lowest: ${formatMoney(low.amount)} on ${shortDate(h, low.day)}</text>
<text x="90" y="160" font-size="30" fill="#64615A">Checking, next 14 days</text>
${grid}${hatch}
<line x1="${plot.x0}" x2="${plot.x1}" y1="${yOf(h.rules.checkingFloor)}" y2="${yOf(h.rules.checkingFloor)}" stroke="#A36A00" stroke-width="3" stroke-dasharray="12 8"/>
<line x1="${plot.x0}" x2="${plot.x1}" y1="${zeroY}" y2="${zeroY}" stroke="#7A766D" stroke-width="4"/>
<text x="${plot.x1 + 6}" y="${zeroY + 9}" font-size="24" font-weight="600" fill="#3D3B37">$0</text>
<polyline points="${step}" fill="none" stroke="#1C6B4A" stroke-width="7" stroke-linejoin="miter"/>
<circle cx="${lx}" cy="${ly}" r="13" fill="#B83A0B" stroke="#F2F1ED" stroke-width="5"/>
${tick(0, 'Today')}${tick(3, 'Tue')}${tick(5, 'Thu')}${tick(13, shortDate(h, 13).slice(5))}
</svg>`;
writeFileSync(join(out, 'week-chart.png'), new Resvg(svg, { font: { loadSystemFonts: true }, fitTo: { mode: 'width', value: W } }).render().asPng());
console.log('wrote', join(out, 'brake-quote.png'), 'and week-chart.png (lowest', formatMoney(low.amount), shortDate(h, low.day) + ')');
