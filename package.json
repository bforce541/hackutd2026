{
  "name": "pacepay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm -r --parallel --stream dev",
    "test": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm -r test",
    "typecheck": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm -r typecheck",
    "build": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm -r build",
    "demo:e2e": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm --filter @pacepay/server demo:e2e",
    "arena": "npx @dotenvx/dotenvx run --convention=nextjs -- pnpm --filter @pacepay/server arena"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
